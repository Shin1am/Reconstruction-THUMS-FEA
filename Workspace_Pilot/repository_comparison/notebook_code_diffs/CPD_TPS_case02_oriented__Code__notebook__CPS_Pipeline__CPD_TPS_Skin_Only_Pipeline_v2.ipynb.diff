+def coverage_damped_blend(original_pts, warped_pts, target_pts, scale,
+                           transition_mm=BLEND_TRANSITION_MM,
+                           smooth_k=CONF_SMOOTH_NEIGHBORS, smooth_iters=CONF_SMOOTH_ITERS):
