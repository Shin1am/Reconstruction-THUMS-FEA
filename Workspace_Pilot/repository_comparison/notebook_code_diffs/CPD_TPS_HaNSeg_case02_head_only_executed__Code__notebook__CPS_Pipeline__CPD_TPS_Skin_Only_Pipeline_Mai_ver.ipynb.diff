-def kabsch_rotation(P, Q):
-    """Rotation R (P @ R.T) mapping centered P onto centered Q."""
-    Pc = P - P.mean(0)
-    Qc = Q - Q.mean(0)
-    H = Pc.T @ Qc
-    U, S, Vt = np.linalg.svd(H)
-    d = np.sign(np.linalg.det(Vt.T @ U.T))
-    D = np.diag([1, 1, d])
-    R = Vt.T @ D @ U.T
-    return R
