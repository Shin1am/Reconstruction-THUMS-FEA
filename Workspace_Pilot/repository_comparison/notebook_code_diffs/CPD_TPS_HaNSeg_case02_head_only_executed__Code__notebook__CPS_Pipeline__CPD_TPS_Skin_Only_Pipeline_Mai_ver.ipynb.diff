+def smooth_skin(coords, k=SKIN_SM[0], passes=SKIN_SM[1]):
+    """Smooth skin: its displacement (vs the template after one affine fit) averaged over its k nearest skin nodes, `passes` times.
+    The interior is rebuilt from the smooth skin (one TPS through it, as in cell 14), so the skin layer is not stretched between a
+    smoothed skin and an interior that followed the unsmoothed one."""
+    H_ = np.c_[all_pts0[skin_idx], np.ones(len(skin_idx))]
+    Rest = np.c_[all_pts0, np.ones(len(all_pts0))] @ np.linalg.lstsq(H_, coords[skin_idx], rcond=None)[0]
+    d = coords[skin_idx] - Rest[skin_idx]
+    nn = cKDTree(Rest[skin_idx]).query(Rest[skin_idx], k=k + 1)[1]
+    for _ in range(passes): d = d[nn].mean(axis=1)
+    skin_sm = Rest[skin_idx] + d
+    out = RBFInterpolator(all_pts0[skin_idx], skin_sm, kernel='thin_plate_spline', smoothing=1e-3)(all_pts0)
+    out[skin_idx] = skin_sm
+    return out, skin_sm
