+    Each pull is averaged over `smooth_k` neighbours so the template folds are not collapsed onto a smoother GT.
+    Brainstem and eyes are pulled towards their own affine fit instead (nearest-point pulls squash them); the GT brain surface contains the
+    brainstem and the template brain does not, so the brain term ignores everything within `stem_excl` mm of the brainstem."""
+    nc = {k: (n_ctrl[k] if isinstance(n_ctrl, dict) else n_ctrl) for k in targets}
+    X = start.copy()
+    rng = np.random.default_rng(seed)
+    ctrl = {k: rng.choice(len(STRUCT_IDX[k]), min(nc[k], len(STRUCT_IDX[k])), replace=False) for k in targets}
+    for lam in lambdas:
+        for _ in range(inner):
+            S, D, SM, rep = [], [], [], {}
+            for k in targets:
+                idx, G = STRUCT_IDX[k], GT_ALL[k]
+                P = X[idx]
+                near = np.zeros(len(P), bool)
+                if k == 'brain' and stem_excl and 'brainstem' in targets:
+                    G = G[cKDTree(GT_PTS['brainstem']).query(G)[0] > stem_excl]
+                    near = cKDTree(X[STRUCT_IDX['brainstem']]).query(P)[0] < stem_excl
+                d, nn = cKDTree(G).query(P)
+                d = np.where(near, np.inf, d)
+                disp = G[nn] - P
+                dg, jn = cKDTree(P).query(G)                          # reverse: GT point -> nearest template node
+                ok = dg < clip
+                cnt = np.bincount(jn[ok], minlength=len(idx)).astype(float)
+                acc = np.stack([np.bincount(jn[ok], weights=G[ok, a], minlength=len(idx)) for a in range(3)], 1)
+                has = cnt > 0
