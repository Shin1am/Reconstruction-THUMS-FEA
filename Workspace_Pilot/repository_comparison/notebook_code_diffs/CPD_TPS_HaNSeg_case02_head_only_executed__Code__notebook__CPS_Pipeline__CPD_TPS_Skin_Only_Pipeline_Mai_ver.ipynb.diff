+    for h, c in enumerate(cases):
+        tr = [i for i, cc in enumerate(cases) if i != h and (train == 'all' or cc not in TIER3)]
+        m1, m2, mj = kr_fit(XS[tr], Y1[tr]), kr_fit(Y1[tr], Y2[tr]), kr_fit(XS[tr], np.c_[Y1[tr], Y2[tr]])
+        y1p = kr_pred(m1, XS[h]); yj = kr_pred(mj, XS[h])
+        out = {'mean': (Y1[tr].mean(0), Y2[tr].mean(0)), 'chain': (y1p, kr_pred(m2, y1p)), 'joint': (yj[:Y1.shape[1]], yj[Y1.shape[1]:])}
+        s_, R_, t_ = TF[c]; preds[c] = {}
+        for name, (p1, p2) in out.items():
+            b, bt = {**blocks(p1, S1), **blocks(p2, S2)}, {**blocks(Y1[h], S1), **blocks(Y2[h], S2)}
+            rows.append(dict(case=c, model=name, tier3=c in TIER3, **{k + '_nodeerr': np.linalg.norm(b[k] - bt[k], axis=1).mean() for k in b}))
+            for k in b: preds[c][f'{name}__{k}'] = ((b[k] - t_) @ R_) / s_
+    return preds, pd.DataFrame(rows)
+
+def register_corr(targets, start, lam=1e3, inner=2):
+    """Pull template nodes with known correspondence (predicted surfaces) to their targets through one stiff TPS; the smooth skin is put back by the caller."""
+    X = start.copy()
+    for _ in range(inner):
+        S = np.vstack([X[ids] for ids, T in targets.values()]); D = np.vstack([T - X[ids] for ids, T in targets.values()])
+        X = X + RBFInterpolator(S, D, kernel='thin_plate_spline', smoothing=np.full(len(S), lam))(X)
+    return X
+
+
+def predicted_mesh(case, preds, method='chain'):
+    """Register the template with the predicted skull, brain, brainstem and eyes of `case` (skin = the observed smooth skin)."""
+    start = np.load(BATCH / case / 'l_skin.npy').astype(float)
+    X = register_corr({k: (SUB[k], preds[case][f'{method}__{k}']) for k in S1 + S2}, start)
+    X[skin_idx] = np.load(BATCH / case / 'skin_sm.npy').astype(float)
+    return X
+
+UT_TAU, UT_MU, UT_RING = 0.10, 1e-4, 1       # target corner quality, spring to the registered position (per mm^2), rings of neighbours that may move
+UT_PIN = ('skin',)                           # structures whose nodes get UT_SKIN_X times the spring (the observed skin should hardly move)
+UT_SKIN_X = 20.0
+UT_BOX = (5.0, 1.5)                          # largest move (mm) of an interior node and of a skin node from the registered position
+
+
+def corner_energy(Xk, ce, tau):
+    """Energy sum (tau - SJ)^2 over the corners of elements `ce` with SJ < tau, and its gradient with respect to the node array Xk (k-file order)."""
+    P = Xk[conn[ce]]
+    E, G = 0.0, np.zeros_like(Xk)
+    for c, (a, b, d) in CORNERS:
+        e1, e2, e3 = P[:, a] - P[:, c], P[:, b] - P[:, c], P[:, d] - P[:, c]
+        n1, n2, n3 = np.linalg.norm(e1, axis=1), np.linalg.norm(e2, axis=1), np.linalg.norm(e3, axis=1)
+        den = np.maximum(n1 * n2 * n3, 1e-300)
+        c23, c31, c12 = np.cross(e2, e3), np.cross(e3, e1), np.cross(e1, e2)
+        s = np.einsum('ij,ij->i', e1, c23) / den
+        act = valid[ce, c] & (s < tau)
+        if not act.any(): continue
+        w = np.where(act, -2.0 * (tau - s), 0.0)
+        E += float(np.sum(np.where(act, (tau - s) ** 2, 0.0)))
+        g1 = w[:, None] * (c23 / den[:, None] - s[:, None] * e1 / np.maximum(n1 ** 2, 1e-300)[:, None])
+        g2 = w[:, None] * (c31 / den[:, None] - s[:, None] * e2 / np.maximum(n2 ** 2, 1e-300)[:, None])
+        g3 = w[:, None] * (c12 / den[:, None] - s[:, None] * e3 / np.maximum(n3 ** 2, 1e-300)[:, None])
+        nodes = conn[ce]
+        np.add.at(G, nodes[:, a], g1); np.add.at(G, nodes[:, b], g2); np.add.at(G, nodes[:, d], g3)
+        np.add.at(G, nodes[:, c], -(g1 + g2 + g3))
+    return E, G
+
+
+def untangle(X, tau=UT_TAU, mu=UT_MU, rings=UT_RING, maxiter=800, pin_skin=False, box=UT_BOX, log=True):
+    """Local mesh repair after the warp: move only the nodes of bad hexahedra (corner scaled Jacobian < tau) and their neighbours so that every corner reaches tau,
+    while a spring holds each node near its registered position (stiffer on the skin). Returns the repaired node array (vtu order)."""
+    from scipy.optimize import minimize
+    Xk0 = X[k_idx].astype(float)
+    sj = corner_sj(Xk0); bad = np.nanmin(sj, axis=1) < tau
+    free = np.zeros(len(Xk0), bool); free[np.unique(conn[bad])] = True
+    for _ in range(rings):
+        free[np.unique(conn[free[conn].any(1)])] = True
+    if pin_skin: free &= ~np.isin(k_idx, skin_idx)                  # the observed skin is never moved
+    fi = np.where(free)[0]; ce = np.where(free[conn].any(1))[0]
+    skin_k = np.isin(k_idx[fi], skin_idx); mu_i = np.where(skin_k, mu * UT_SKIN_X, mu)[:, None]
+    def fun(v):
+        Xk = Xk0.copy(); Xk[fi] = v.reshape(-1, 3)
+        E, G = corner_energy(Xk, ce, tau)
+        d = Xk[fi] - Xk0[fi]
+        return E + float((mu_i * d ** 2).sum()), (G[fi] + 2.0 * mu_i * d).ravel()
+    n0 = int((np.nanmin(sj, axis=1) <= 0).sum())
+    lim = np.where(skin_k, box[1], box[0])[:, None] * np.ones((1, 3)); x0 = Xk0[fi]
+    res = minimize(fun, x0.ravel(), jac=True, method='L-BFGS-B', bounds=list(zip((x0 - lim).ravel(), (x0 + lim).ravel())), options=dict(maxiter=maxiter, maxfun=maxiter * 2))
+    Xk = Xk0.copy(); Xk[fi] = res.x.reshape(-1, 3)
+    n1 = int((np.nanmin(corner_sj(Xk), axis=1) <= 0).sum())
+    if log: print(f'untangle: {len(fi):,} free nodes, {len(ce):,} elements, failing {n0} -> {n1}, {res.nit} iterations, max move {np.linalg.norm(Xk[fi] - Xk0[fi], axis=1).max():.2f} mm')
+    out = X.copy(); out[k_idx] = Xk
+    return out
+
+# Example: repair the predicted mesh of one case (needs cells 2, 4, 18 and the batch folder of cell 13)
+case = 'case_02'
+X = np.load(BATCH / 'res' / f'{case}_all_chain.npy').astype(float)       # predicted mesh of the leave-one-out run
+Y = untangle(X)                                                           # no solid with a corner scaled Jacobian <= 0 afterwards
+sj = np.nanmin(corner_sj(Y[k_idx]), axis=1)
+print('failing', int((sj <= 0).sum()), '| below 0.1:', int((sj < 0.1).sum()), '| minimum', round(float(sj.min()), 4))
+
+DECK = Path(DATA_ROOT) / 'Data/Ls_dyna_model/Head_V6_impact_baseline.k'     # right-hemisphere head + moving rigid wall (fits the 128K-element student cap)
+
+
+def write_deck(X_world, out_path):
+    """Write the half-head impact deck for a warped mesh (all 179,676 nodes, subject frame, vtu order): only the *NODE coordinates of the baseline deck change.
+    The head is first put back into the template pose (rigid fit on the deck nodes) so the wall and the fixed node set act where they did on the template."""
+    lines = open(DECK, errors='replace').read().split('\n')
+    i0 = next(i for i, l in enumerate(lines) if l.startswith('*NODE')) + 1
+    i1 = next(i for i in range(i0, len(lines)) if lines[i].startswith('*'))
+    rows = [i for i in range(i0, i1) if not lines[i].startswith('$') and lines[i].strip()]
+    vi = np.array([id2idx[int(lines[r][:8])] for r in rows])
+    T0 = np.asarray(tmpl.points, float)
+    Xt = np.asarray(X_world, float) @ AXIS_MAP                                 # back to the THUMS axes
+    A, B = Xt[vi], T0[vi]; ca, cb = A.mean(0), B.mean(0)
+    U, _, Vt = np.linalg.svd((A - ca).T @ (B - cb)); R = Vt.T @ np.diag([1, 1, np.sign(np.linalg.det(Vt.T @ U.T))]) @ U.T
+    Xp = (Xt - ca) @ R.T + cb
+    for r, v in zip(rows, vi): lines[r] = lines[r][:8] + ''.join(f'{c:16.8g}' for c in Xp[v]) + lines[r][56:]
+    Path(out_path).parent.mkdir(parents=True, exist_ok=True); open(out_path, 'w').write('\n'.join(lines))
+    ie = next(i for i, l in enumerate(lines) if l.startswith('*ELEMENT_SOLID')) + 1
+    eids = []
+    for l in lines[ie:]:
+        if l.startswith('*'): break
+        if not l.startswith('$') and l.strip(): eids.append(int(l[:8]))
+    in_deck = np.isin(e_ids, np.array(eids)); sj = np.nanmin(corner_sj((Xp @ AXIS_MAP.T)[k_idx]), axis=1)
+    print(f'{out_path}: {in_deck.sum():,} solids, failing {int(((sj <= 0) & in_deck).sum())}, below 0.1: {int(((sj < 0.1) & in_deck).sum())}; '
+          f'pose rms to the template {np.sqrt(((Xp[vi] - T0[vi]) ** 2).sum(1).mean()):.2f} mm')
+    return Xp
+
