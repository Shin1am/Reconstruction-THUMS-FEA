+def umeyama(src, dst):
+    """Similarity (scale, rotation, translation) mapping src onto dst."""
+    mu_s, mu_d = src.mean(0), dst.mean(0)
+    U_, D_, Vt_ = np.linalg.svd((dst - mu_d).T @ (src - mu_s) / len(src))
+    d = np.diag([1, 1, np.sign(np.linalg.det(U_) * np.linalg.det(Vt_))])
+    R = U_ @ d @ Vt_
+    s = np.trace(np.diag(D_) @ d) / (src - mu_s).var(0).sum()
+    return s, R, mu_d - s * R @ mu_s
