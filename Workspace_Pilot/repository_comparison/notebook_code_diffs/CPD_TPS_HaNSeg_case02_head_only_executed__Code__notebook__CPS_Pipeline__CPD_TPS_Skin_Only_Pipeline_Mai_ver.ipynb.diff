+def fit_affine(P, G, iters=40, trim=0.85):
+    """Trimmed bidirectional ICP, 12-DOF affine P -> G; singular values clamped so a small structure cannot collapse or stretch."""
+    A, t = np.eye(3), np.zeros(3)
+    tg = cKDTree(G)
+    for _ in range(iters):
+        Q = P @ A.T + t
+        d1, n1 = tg.query(Q); k1 = d1 <= np.quantile(d1, trim)
+        d2, n2 = cKDTree(Q).query(G); k2 = d2 <= np.quantile(d2, trim)
+        src = np.vstack([P[k1], P[n2[k2]]]); dst = np.vstack([G[n1[k1]], G[k2]])
+        M = np.linalg.lstsq(np.c_[src, np.ones(len(src))], dst, rcond=None)[0]
+        U, S, Vt = np.linalg.svd(M[:3].T)
+        if np.linalg.det(U) * np.linalg.det(Vt) < 0: Vt[-1] *= -1
+        A = U @ np.diag(np.clip(S, *SCALE_CLAMP)) @ Vt
+        t = (dst - src @ A.T).mean(0)
+    return A, t
