+def small_targets(P, G, k):
+    """Target positions of a small structure: the brainstem is fitted as a whole, each eye on its own."""
+    if k != 'eyes':
+        A, t = fit_affine(P, G); return P @ A.T + t
+    out = np.zeros_like(P); left = P[:, 0] < P[:, 0].mean()
+    for sel in (left, ~left):
+        g = (G[:, 0] < G[:, 0].mean()) if sel is left else (G[:, 0] >= G[:, 0].mean())
+        A, t = fit_affine(P[sel], G[g]); out[sel] = P[sel] @ A.T + t
+    return out
