+    n_ = len(Xt); err = np.zeros((len(RANKS), len(RIDGE)))
+    for j in range(n_):
+        idx = np.delete(np.arange(n_), j); mx, my = Xt[idx].mean(0), Yt[idx].mean(0)
+        Xc, Yc = Xt[idx] - mx, Yt[idx] - my
+        K = Xc @ Xc.T; sc = np.trace(K) / len(K); w, U = np.linalg.eigh(K); w, U = w[::-1], U[:, ::-1]
+        UtY = U.T @ Yc; kU = ((Xt[j] - mx) @ Xc.T) @ U
+        for ir, r in enumerate(RANKS):
+            for ic, c_ in enumerate(RIDGE):
+                err[ir, ic] += ((my + (kU[:r] / (np.maximum(w[:r], 1e-12) + c_ * sc)) @ UtY[:r] - Yt[j]) ** 2).mean()
+    ir, ic = np.unravel_index(np.argmin(err), err.shape); r, c_ = RANKS[ir], RIDGE[ic]
+    mx, my = Xt.mean(0), Yt.mean(0); Xc, Yc = Xt - mx, Yt - my
