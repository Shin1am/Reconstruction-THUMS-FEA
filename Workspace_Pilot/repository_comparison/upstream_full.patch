+    "                s=0.3, c=WARP_COL, alpha=0.4, rasterized=True)\n",
+    "    style_ax(ax2, \"Coronal overlay  (X–Z)\")\n",
+    "    ax2.set_xlabel(\"X (mm)\", color=\"gray\", fontsize=8)\n",
+    "    ax2.set_ylabel(\"Z (mm)\", color=\"gray\", fontsize=8)\n",
+    "\n",
+    "    # ── Panel 3: Sagittal overlay (YZ plane) ─────────────────────\n",
+    "    ax3 = fig.add_subplot(gs[0, 2])\n",
+    "    ax3.scatter(pts_orig[:, 1],   pts_orig[:, 2],\n",
+    "                s=0.3, c=ORIG_COL,  alpha=0.4, rasterized=True)\n",
+    "    ax3.scatter(pts_warped[:, 1], pts_warped[:, 2],\n",
+    "                s=0.3, c=WARP_COL, alpha=0.4, rasterized=True)\n",
+    "    style_ax(ax3, \"Sagittal overlay  (Y–Z)\")\n",
+    "    ax3.set_xlabel(\"Y (mm)\", color=\"gray\", fontsize=8)\n",
+    "    ax3.set_ylabel(\"Z (mm)\", color=\"gray\", fontsize=8)\n",
+    "\n",
+    "    # ── Panel 4: Metric summary text ─────────────────────────────\n",
+    "    ax4 = fig.add_subplot(gs[0, 3])\n",
+    "    ax4.axis(\"off\")\n",
+    "    ax4.set_facecolor(\"#1a1a1a\")\n",
+    "\n",
+    "    def fmt(v): return f\"{v:.2f}\"\n",
+    "\n",
+    "    lines = [\n",
+    "        (\"SURFACE DISTANCE\", \"\"),\n",
+    "        (\"Mean\",    f\"{fmt(metrics['mean_surf_dist_mm'])} mm\"),\n",
