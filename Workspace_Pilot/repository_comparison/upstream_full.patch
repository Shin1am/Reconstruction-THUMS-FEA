+        "elems_shell":{},   # eid -> (pid, raw_line)
+        "elems_beam": {},
+        "elems_disc": {},
+        "parts":      {},   # pid -> (kw_line, [data_lines])
+        "sections":   {},   # secid -> (kw, lines)
+        "mats":       {},   # mid -> (kw, lines)
+        "eos":        {},
+        "hourglass":  {},
+        "define":     {},   # lcid -> (kw, lines) — *DEFINE_CURVE, *DEFINE_TABLE etc
+        "raw_blocks": [],   # [(kw, lines)] for everything else
+    }
