+        except ValueError:
+            pass
+    stripped = line.rstrip()
+    if len(stripped) >= n_fields * width and len(stripped) % width == 0:
+        try:
+            return [int(stripped[i:i+width]) for i in range(0, len(stripped), width)]
+        except ValueError:
+            return None
+    return None
