+    "    Diagnoses coordinate space mismatch between two .vtu files\n",
+    "    \"\"\"\n",
+    "    def load_vtu(path):\n",
+    "        reader = vtk.vtkXMLUnstructuredGridReader()\n",
+    "        reader.SetFileName(path)\n",
+    "        reader.Update()\n",
+    "        mesh = reader.GetOutput()\n",
+    "        \n",
+    "        bounds = mesh.GetBounds()\n",
