+     "name": "stdout",
+     "output_type": "stream",
+     "text": [
+      "PCA pre-alignment rotation (best of 4 valid sign combinations):\n",
+      "[[-0.989  0.077 -0.125]\n",
+      " [ 0.058  0.987  0.147]\n",
+      " [ 0.135  0.139 -0.981]]\n",
+      "Mean NN distance after PCA align: 16.05 (normalized units)\n"
+     ]
+    },
