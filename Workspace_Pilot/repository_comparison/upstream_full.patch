+   "cell_type": "code",
+   "execution_count": 10,
+   "id": "dc98ea7b",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def warp_points_clamped(nodes, reg, max_disp_mm=30.0):\n",
+    "    warped = warp_points(nodes, reg)\n",
+    "    disp = warped - nodes\n",
+    "    mag = np.linalg.norm(disp, axis=1)\n",
+    "    scale_factor = np.minimum(1.0, max_disp_mm / (mag + 1e-8))\n",
+    "    warped_clamped = nodes + disp * scale_factor[:, None]\n",
+    "    n_clamped = (scale_factor < 1.0).sum()\n",
+    "    print(f\"Clamped {n_clamped} points exceeding {max_disp_mm}mm\")\n",
+    "    return warped_clamped"
+   ]
+  },
