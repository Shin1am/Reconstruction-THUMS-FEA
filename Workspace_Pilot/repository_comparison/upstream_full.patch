+tick('stage2_rigid_cpd', t0)
+
+t0 = time.time()
+affine_reg = AffineRegistration(X=fixed_lm, Y=TY_rigid, max_iterations=CPD_MAX_ITER, tolerance=CPD_TOL)
+_, (B_a, t_a) = affine_reg.register()
