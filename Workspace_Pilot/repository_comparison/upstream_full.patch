+   "source": [
+    "BATCH = OUTD / 'out_tmp_batch'        # one folder per case: l_skin.npy, c1_stiff.npy, skin_sm.npy (batch run of cells 0-12 with MAI_C1='l_skin,c1_stiff')\n",
+    "TIER3 = {'case_07', 'case_27', 'case_30', 'case_34', 'case_41'}      # head tipped back: the nose-tip start is wrong\n",
+    "S1, S2 = ['skull_outer', 'skull_inner'], ['brain', 'brainstem', 'eyes']\n",
+    "NSUB = {'skin': 1500, 'skull_outer': 1200, 'skull_inner': 1200, 'brain': 1500, 'brainstem': 400, 'eyes': 600}\n",
+    "_rng = np.random.default_rng(0)\n",
+    "SUB = {k: np.sort(_rng.choice(STRUCT_IDX[k], n, replace=False)) for k, n in NSUB.items()}      # the same template nodes in every case\n",
+    "_skin_pos = {int(n): i for i, n in enumerate(skin_idx)}\n",
+    "SKIN_POS = np.array([_skin_pos[int(n)] for n in SUB['skin']])\n",
+    "RANKS, RIDGE = (1, 2, 3, 4, 6, 8, 12, 16, 24), (1e-4, 1e-3, 1e-2, 1e-1, 1.0)\n",
+    "\n",
+    "\n",
+    "def umeyama(src, dst):\n",
+    "    \"\"\"Similarity (scale, rotation, translation) mapping src onto dst.\"\"\"\n",
+    "    mu_s, mu_d = src.mean(0), dst.mean(0)\n",
+    "    U_, D_, Vt_ = np.linalg.svd((dst - mu_d).T @ (src - mu_s) / len(src))\n",
+    "    d = np.diag([1, 1, np.sign(np.linalg.det(U_) * np.linalg.det(Vt_))])\n",
+    "    R = U_ @ d @ Vt_\n",
+    "    s = np.trace(np.diag(D_) @ d) / (src - mu_s).var(0).sum()\n",
+    "    return s, R, mu_d - s * R @ mu_s\n",
+    "\n",
+    "\n",
+    "def build_dataset(cases):\n",
+    "    \"\"\"Per case: smooth skin and the C1 interior of the chosen template nodes, aligned by the skin only (generalised Procrustes).\"\"\"\n",
+    "    raw = {}\n",
+    "    for c in cases:\n",
+    "        X = np.load(BATCH / c / 'c1_stiff.npy').astype(float)\n",
+    "        raw[c] = (np.load(BATCH / c / 'skin_sm.npy').astype(float)[SKIN_POS], {k: X[SUB[k]] for k in S1 + S2})\n",
+    "    ref = raw[cases[0]][0].copy()\n",
+    "    for _ in range(6):\n",
+    "        al_ = []\n",
+    "        for c in cases:\n",
+    "            s, R, t = umeyama(raw[c][0], ref); al_.append(s * raw[c][0] @ R.T + t)\n",
+    "        ref = np.mean(al_, 0)\n",
+    "    TF = {c: umeyama(raw[c][0], ref) for c in cases}\n",
+    "    al = lambda c, P: TF[c][0] * P @ TF[c][1].T + TF[c][2]\n",
+    "    XS = np.array([al(c, raw[c][0]).ravel() for c in cases])\n",
+    "    Y1 = np.array([np.concatenate([al(c, raw[c][1][k]).ravel() for k in S1]) for c in cases])\n",
+    "    Y2 = np.array([np.concatenate([al(c, raw[c][1][k]).ravel() for k in S2]) for c in cases])\n",
+    "    return TF, XS, Y1, Y2\n",
+    "\n",
+    "\n",
+    "def kr_fit(Xt, Yt):\n",
+    "    \"\"\"Reduced-rank ridge regression (top r shape modes of the predictor + ridge lam), r and lam chosen by explicit leave-one-out refits.\"\"\"\n",
+    "    n_ = len(Xt); err = np.zeros((len(RANKS), len(RIDGE)))\n",
+    "    for j in range(n_):\n",
+    "        idx = np.delete(np.arange(n_), j); mx, my = Xt[idx].mean(0), Yt[idx].mean(0)\n",
+    "        Xc, Yc = Xt[idx] - mx, Yt[idx] - my\n",
+    "        K = Xc @ Xc.T; sc = np.trace(K) / len(K); w, U = np.linalg.eigh(K); w, U = w[::-1], U[:, ::-1]\n",
+    "        UtY = U.T @ Yc; kU = ((Xt[j] - mx) @ Xc.T) @ U\n",
+    "        for ir, r in enumerate(RANKS):\n",
+    "            for ic, c_ in enumerate(RIDGE):\n",
+    "                err[ir, ic] += ((my + (kU[:r] / (np.maximum(w[:r], 1e-12) + c_ * sc)) @ UtY[:r] - Yt[j]) ** 2).mean()\n",
+    "    ir, ic = np.unravel_index(np.argmin(err), err.shape); r, c_ = RANKS[ir], RIDGE[ic]\n",
+    "    mx, my = Xt.mean(0), Yt.mean(0); Xc, Yc = Xt - mx, Yt - my\n",
+    "    K = Xc @ Xc.T; sc = np.trace(K) / len(K); w, U = np.linalg.eigh(K); w, U = w[::-1], U[:, ::-1]\n",
+    "    A = (U[:, :r] / (np.maximum(w[:r], 1e-12) + c_ * sc)) @ U[:, :r].T\n",
+    "    return dict(mx=mx, my=my, Xc=Xc, alpha=A @ Yc, c=c_, r=r)\n",
+    "\n",
+    "\n",
+    "def kr_pred(m, x): return m['my'] + ((x - m['mx']) @ m['Xc'].T) @ m['alpha']\n",
+    "\n",
+    "\n",
+    "def blocks(v, ks):\n",
+    "    out, i = {}, 0\n",
+    "    for k in ks: out[k] = v[i:i + NSUB[k] * 3].reshape(-1, 3); i += NSUB[k] * 3\n",
+    "    return out\n",
+    "\n",
+    "\n",
+    "def loo_predictions(cases, train='all'):\n",
+    "    \"\"\"Leave one subject out: skin -> skull (stage 1), skull -> brain, brainstem, eyes (stage 2, trained on the true skull), plus the\n",
+    "    mean shape and a joint skin -> everything model. Returns world-frame target positions per case and the node errors against C1.\"\"\"\n",
+    "    TF, XS, Y1, Y2 = build_dataset(cases); preds, rows = {}, []\n",
+    "    for h, c in enumerate(cases):\n",
+    "        tr = [i for i, cc in enumerate(cases) if i != h and (train == 'all' or cc not in TIER3)]\n",
+    "        m1, m2, mj = kr_fit(XS[tr], Y1[tr]), kr_fit(Y1[tr], Y2[tr]), kr_fit(XS[tr], np.c_[Y1[tr], Y2[tr]])\n",
+    "        y1p = kr_pred(m1, XS[h]); yj = kr_pred(mj, XS[h])\n",
+    "        out = {'mean': (Y1[tr].mean(0), Y2[tr].mean(0)), 'chain': (y1p, kr_pred(m2, y1p)), 'joint': (yj[:Y1.shape[1]], yj[Y1.shape[1]:])}\n",
+    "        s_, R_, t_ = TF[c]; preds[c] = {}\n",
+    "        for name, (p1, p2) in out.items():\n",
+    "            b, bt = {**blocks(p1, S1), **blocks(p2, S2)}, {**blocks(Y1[h], S1), **blocks(Y2[h], S2)}\n",
+    "            rows.append(dict(case=c, model=name, tier3=c in TIER3, **{k + '_nodeerr': np.linalg.norm(b[k] - bt[k], axis=1).mean() for k in b}))\n",
+    "            for k in b: preds[c][f'{name}__{k}'] = ((b[k] - t_) @ R_) / s_\n",
+    "    return preds, pd.DataFrame(rows)"
+   ]
