+    "json.dump(dict(case=CASE, name=NAME, init=INIT, crop=CROP, w=CPD_W, icp=USE_ICP, rigid_scale=float(s_r), z_cut=float(z_cut),\n",
+    "               final=summary.iloc[-1].to_dict()), open(OUT / 'run_meta.json', 'w'), indent=1, default=float)\n",
+    "print('saved', OUT)"
+   ]
