+zplane = zplane - 0.35 * np.abs(xx_ - Ax) * 1.0                 # tent: droops laterally
+zgrid = np.arange(Z)[:, None, None]
+np.save(f"{out}/tent_zplane.npy", zplane); json.dump({"Ay": float(Ay), "Ax": float(Ax), "Az": float(Az)}, open(f"{out}/tent_params.json", "w"))
