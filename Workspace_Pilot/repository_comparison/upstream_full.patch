+   "outputs": [],
+   "source": [
+    "STRUCT_IDX = {'skin': skin_idx}\n",
+    "for _k, (_pl, _) in STRUCT.items():\n",
+    "    _m = tmpl.extract_cells(np.where(np.isin(pids, _pl))[0]).extract_surface(algorithm='dataset_surface')\n",
+    "    STRUCT_IDX[_k] = np.array([id2idx[int(n)] for n in _m.point_data['node_id']])\n",
+    "GT_ALL = {'skin': skin_crop, **GT_PTS}\n",
+    "INNER = ['skull_outer', 'skull_inner', 'brain', 'brainstem', 'eyes']\n",
+    "C1_INNER_IT, C1_NCTRL, C1_CLIP, SKIN_SM = 2, 1000, 25.0, (30, 3)         # SKIN_SM = (neighbours, passes) of the skin smoothing\n",
+    "SMALL, STEM_EXCL, SCALE_CLAMP = ('brainstem', 'eyes'), 25.0, (0.8, 1.25)  # small structures get their own affine fit; mm kept away from the brainstem in the brain term\n",
+    "\n",
+    "\n",
+    "def smooth_skin(coords, k=SKIN_SM[0], passes=SKIN_SM[1]):\n",
+    "    \"\"\"Smooth skin: its displacement (vs the template after one affine fit) averaged over its k nearest skin nodes, `passes` times.\n",
+    "    The interior is rebuilt from the smooth skin (one TPS through it, as in cell 14), so the skin layer is not stretched between a\n",
+    "    smoothed skin and an interior that followed the unsmoothed one.\"\"\"\n",
+    "    H_ = np.c_[all_pts0[skin_idx], np.ones(len(skin_idx))]\n",
+    "    Rest = np.c_[all_pts0, np.ones(len(all_pts0))] @ np.linalg.lstsq(H_, coords[skin_idx], rcond=None)[0]\n",
+    "    d = coords[skin_idx] - Rest[skin_idx]\n",
+    "    nn = cKDTree(Rest[skin_idx]).query(Rest[skin_idx], k=k + 1)[1]\n",
+    "    for _ in range(passes): d = d[nn].mean(axis=1)\n",
+    "    skin_sm = Rest[skin_idx] + d\n",
+    "    out = RBFInterpolator(all_pts0[skin_idx], skin_sm, kernel='thin_plate_spline', smoothing=1e-3)(all_pts0)\n",
+    "    out[skin_idx] = skin_sm\n",
+    "    return out, skin_sm\n",
+    "\n",
+    "\n",
+    "def fit_affine(P, G, iters=40, trim=0.85):\n",
+    "    \"\"\"Trimmed bidirectional ICP, 12-DOF affine P -> G; singular values clamped so a small structure cannot collapse or stretch.\"\"\"\n",
+    "    A, t = np.eye(3), np.zeros(3)\n",
+    "    tg = cKDTree(G)\n",
+    "    for _ in range(iters):\n",
+    "        Q = P @ A.T + t\n",
+    "        d1, n1 = tg.query(Q); k1 = d1 <= np.quantile(d1, trim)\n",
+    "        d2, n2 = cKDTree(Q).query(G); k2 = d2 <= np.quantile(d2, trim)\n",
+    "        src = np.vstack([P[k1], P[n2[k2]]]); dst = np.vstack([G[n1[k1]], G[k2]])\n",
+    "        M = np.linalg.lstsq(np.c_[src, np.ones(len(src))], dst, rcond=None)[0]\n",
+    "        U, S, Vt = np.linalg.svd(M[:3].T)\n",
+    "        if np.linalg.det(U) * np.linalg.det(Vt) < 0: Vt[-1] *= -1\n",
+    "        A = U @ np.diag(np.clip(S, *SCALE_CLAMP)) @ Vt\n",
+    "        t = (dst - src @ A.T).mean(0)\n",
+    "    return A, t\n",
+    "\n",
+    "\n",
+    "def small_targets(P, G, k):\n",
+    "    \"\"\"Target positions of a small structure: the brainstem is fitted as a whole, each eye on its own.\"\"\"\n",
+    "    if k != 'eyes':\n",
+    "        A, t = fit_affine(P, G); return P @ A.T + t\n",
+    "    out = np.zeros_like(P); left = P[:, 0] < P[:, 0].mean()\n",
+    "    for sel in (left, ~left):\n",
+    "        g = (G[:, 0] < G[:, 0].mean()) if sel is left else (G[:, 0] >= G[:, 0].mean())\n",
+    "        A, t = fit_affine(P[sel], G[g]); out[sel] = P[sel] @ A.T + t\n",
+    "    return out\n",
+    "\n",
+    "\n",
+    "def register(targets, start, lambdas=(1e3,), inner=C1_INNER_IT, n_ctrl=C1_NCTRL, clip=C1_CLIP, smooth_k=20, stem_excl=STEM_EXCL, w_struct=None, seed=0, log=True):\n",
+    "    \"\"\"One data term per structure in `targets` (equal total weight), thin-plate-spline regulariser, stiff -> flexible.\n",
+    "    Each pull is averaged over `smooth_k` neighbours so the template folds are not collapsed onto a smoother GT.\n",
+    "    Brainstem and eyes are pulled towards their own affine fit instead (nearest-point pulls squash them); the GT brain surface contains the\n",
+    "    brainstem and the template brain does not, so the brain term ignores everything within `stem_excl` mm of the brainstem.\"\"\"\n",
+    "    nc = {k: (n_ctrl[k] if isinstance(n_ctrl, dict) else n_ctrl) for k in targets}\n",
+    "    X = start.copy()\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    ctrl = {k: rng.choice(len(STRUCT_IDX[k]), min(nc[k], len(STRUCT_IDX[k])), replace=False) for k in targets}\n",
+    "    for lam in lambdas:\n",
+    "        for _ in range(inner):\n",
+    "            S, D, SM, rep = [], [], [], {}\n",
+    "            for k in targets:\n",
+    "                idx, G = STRUCT_IDX[k], GT_ALL[k]\n",
+    "                P = X[idx]\n",
+    "                near = np.zeros(len(P), bool)\n",
+    "                if k == 'brain' and stem_excl and 'brainstem' in targets:\n",
+    "                    G = G[cKDTree(GT_PTS['brainstem']).query(G)[0] > stem_excl]\n",
+    "                    near = cKDTree(X[STRUCT_IDX['brainstem']]).query(P)[0] < stem_excl\n",
+    "                d, nn = cKDTree(G).query(P)\n",
+    "                d = np.where(near, np.inf, d)\n",
+    "                disp = G[nn] - P\n",
+    "                dg, jn = cKDTree(P).query(G)                          # reverse: GT point -> nearest template node\n",
+    "                ok = dg < clip\n",
+    "                cnt = np.bincount(jn[ok], minlength=len(idx)).astype(float)\n",
+    "                acc = np.stack([np.bincount(jn[ok], weights=G[ok, a], minlength=len(idx)) for a in range(3)], 1)\n",
+    "                has = cnt > 0\n",
+    "                disp[has] = 0.5 * (disp[has] + acc[has] / cnt[has, None] - P[has])\n",
+    "                disp[d >= clip] = 0.0\n",
+    "                if k in SMALL:\n",
+    "                    disp = small_targets(P, G, k) - P; d = np.zeros_like(d)\n",
+    "                c = ctrl[k]\n",
+    "                disp_c = disp[cKDTree(P).query(P[c], k=smooth_k + 1)[1]].mean(axis=1) if (smooth_k and k not in SMALL) else disp[c]\n",
+    "                sel = d[c] < clip                                      # drop pairs without a counterpart\n",
+    "                S.append(P[c][sel]); D.append(disp_c[sel]); SM.append(np.full(sel.sum(), lam * nc[k] / max(sel.sum(), 1) / (w_struct or {}).get(k, 1.0)))\n",
+    "                rep[k] = (d.mean(), int(sel.sum()))\n",
+    "            S, D, SM = np.vstack(S), np.vstack(D), np.concatenate(SM)\n",
+    "            X = X + RBFInterpolator(S, D, kernel='thin_plate_spline', smoothing=SM)(X)\n",
+    "        if log: print(f'lam {lam:g}: ' + ' '.join(f'{k} {v[0]:.2f}({v[1]})' for k, v in rep.items()), flush=True)\n",
+    "    return X"
+   ]
+  },
