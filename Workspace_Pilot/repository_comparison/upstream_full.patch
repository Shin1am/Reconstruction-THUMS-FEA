+   "source": [
+    "def skin_landmarks(P, win=0.0):\n",
+    "    W = P if win <= 0 else P[P[:, 2] >= P[:, 2].max() - win]\n",
+    "    return np.array([P[np.argmax(P[:, 2])], W[np.argmin(W[:, 1])]])    # vertex, nose tip (most anterior; LPS y<0 = anterior)\n",
+    "\n",
+    "\n",
+    "if INIT == 'eyes':\n",
+    "    c_fixed, c_moving = gt_eye_c, tmpl_eye_c\n",
+    "elif INIT == 'skinlm':\n",
+    "    c_fixed, c_moving = skin_landmarks(skin_crop, NOSE_WIN).mean(0), skin_landmarks(skin_pts0[tmpl_keep]).mean(0)\n",
+    "else:\n",
+    "    c_fixed, c_moving = subject_pts.mean(0), skin_pts0[tmpl_keep].mean(0)\n",
+    "scale = 1.0\n",
+    "subj = subject_pts - c_fixed\n",
+    "tmpl_skin = (skin_pts0 - c_moving) * scale\n",
+    "tmpl_all = (all_pts0 - c_moving) * scale\n",
+    "\n",
+    "\n",
+    "def fps(points, n, seed=0):\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    n = min(n, len(points))\n",
+    "    sel = np.empty(n, dtype=np.int64)\n",
+    "    sel[0] = rng.integers(len(points))\n",
+    "    dist = np.linalg.norm(points - points[sel[0]], axis=1)\n",
+    "    for k in range(1, n):\n",
+    "        sel[k] = np.argmax(dist)\n",
+    "        dist = np.minimum(dist, np.linalg.norm(points - points[sel[k]], axis=1))\n",
+    "    return sel\n",
+    "\n",
+    "\n",
+    "fixed_lm = subj[fps(subj, N_LM)]\n",
+    "moving_lm = tmpl_skin[tmpl_keep][fps(tmpl_skin[tmpl_keep], N_LM)]\n",
+    "print('start:', INIT, '| landmarks', fixed_lm.shape, moving_lm.shape)\n",
+    "print('diagnostic only (not used): eye-centroid offset template vs subject after this start = %.1f mm'\n",
+    "      % np.linalg.norm((gt_eye_c - c_fixed) - (tmpl_eye_c - c_moving)))"
+   ]
