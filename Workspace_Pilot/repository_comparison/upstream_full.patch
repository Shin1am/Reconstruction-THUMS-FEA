+def split_fields(line, n_fields, width=8):
+    """Handles comma, space, and fixed-width I8 (THUMS) formats."""
+    if "," in line:
+        try:
+            return [int(p) for p in line.split(",")]
+        except ValueError:
+            pass
+    parts = line.split()
+    if len(parts) >= n_fields:
