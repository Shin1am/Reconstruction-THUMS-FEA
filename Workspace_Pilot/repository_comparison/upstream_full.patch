+   "source": [
+    "t0 = time.time()\n",
+    "TY_rigid, (s_r, R_r, t_r) = RigidRegistration(X=fixed_lm, Y=moving_lm, w=CPD_W, max_iterations=CPD_MAX_ITER, tolerance=CPD_TOL).register()\n",
