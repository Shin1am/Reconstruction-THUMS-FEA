+    "\n",
+    "    ax4.set_title(\"Metrics\", color=\"white\", fontsize=9, pad=4)\n",
+    "    for spine in ax4.spines.values():\n",
+    "        spine.set_edgecolor(\"#444444\")\n",
+    "\n",
+    "    # ── Panel 5: Surface distance histogram ──────────────────────\n",
+    "    ax5 = fig.add_subplot(gs[1, 0:2])\n",
+    "    sym = metrics[\"symmetric_dist\"]\n",
+    "    ax5.hist(sym, bins=80, color=DIFF_COL, alpha=0.85, edgecolor=\"none\")\n",
+    "    ax5.axvline(metrics[\"mean_surf_dist_mm\"], color=\"white\",\n",
+    "                linewidth=1.5, linestyle=\"--\",\n",
+    "                label=f\"Mean {metrics['mean_surf_dist_mm']:.2f} mm\")\n",
+    "    ax5.axvline(metrics[\"hausdorff_mm\"], color=ORIG_COL,\n",
