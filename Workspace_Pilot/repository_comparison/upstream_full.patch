+    "reg_affine.AddCommand(sitk.sitkIterationEvent, lambda: log_metric(reg_affine))\n",
+    "\n",
+    "affine_tx     = reg_affine.Execute(fixed, moving)\n",
+    "print(f\"\\n   Metric : {reg_affine.GetMetricValue():.6f}\")\n",
