+    "        (\"CENTROID SHIFT\", \"\"),\n",
+    "        (\"Shift\",   f\"{fmt(metrics['centroid_shift_mm'])} mm\"),\n",
+    "        (\"\", \"\"),\n",
+    "        (\"EXTENT CHANGE (mm)\", \"\"),\n",
+    "        (\"ΔX\",  f\"{fmt(metrics['extent_change_mm'][0])}\"),\n",
+    "        (\"ΔY\",  f\"{fmt(metrics['extent_change_mm'][1])}\"),\n",
+    "        (\"ΔZ\",  f\"{fmt(metrics['extent_change_mm'][2])}\"),\n",
+    "        (\"\", \"\"),\n",
+    "        (\"POINTS\", \"\"),\n",
+    "        (\"Original\", f\"{metrics['n_points_orig']:,}\"),\n",
+    "        (\"Warped\",   f\"{metrics['n_points_warped']:,}\"),\n",
+    "    ]\n",
+    "\n",
+    "    y = 0.97\n",
+    "    for label, val in lines:\n",
+    "        if val == \"\" and label != \"\":\n",
+    "            ax4.text(0.04, y, label, transform=ax4.transAxes,\n",
+    "                     color=DIFF_COL, fontsize=8, fontweight=\"bold\")\n",
