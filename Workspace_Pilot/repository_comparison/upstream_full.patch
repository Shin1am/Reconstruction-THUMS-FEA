+    "_, (B_a, t_a) = AffineRegistration(X=fixed_lm, Y=TY_rigid, w=CPD_W, max_iterations=CPD_MAX_ITER, tolerance=CPD_TOL).register()\n",
+    "U, S, Vt = np.linalg.svd(B_a)\n",
+    "TY_affine = TY_rigid @ (U @ np.diag(np.clip(S, *AFFINE_SV_CLAMP)) @ Vt) + t_a\n",
