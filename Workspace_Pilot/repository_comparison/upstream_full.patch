+    "    s[hi < 0] = \"reversed (all corners negative)\"\n",
+    "    return s, lo\n",
+    "\n",
+    "\n",
+    "st0, minsj0 = state(sj0)\n",
+    "st1, minsj1 = state(sj1)"
