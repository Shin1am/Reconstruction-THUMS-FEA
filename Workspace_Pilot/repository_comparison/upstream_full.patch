+    }
+   },
+   "outputs": [
+    {
+     "name": "stdout",
+     "output_type": "stream",
+     "text": [
+      "Warp kept in full (warp was better)  : 2,646 / 10,029 points\n",
+      "Reverted to original (original was better): 3,263 / 10,029 points\n",
+      "Partially blended                     : 4,120 / 10,029 points\n",
+      "Confidence changed by smoothing -- mean 0.035, max 0.920, 1,239 points shifted by >0.1\n",
+      "Do-no-harm check -- mean residual: original=11.46mm  warped=14.18mm  blended=8.91mm\n",
+      "                     max residual : original=62.99mm  warped=56.26mm  blended=65.51mm\n"
+     ]
+    },
