+    "def register_corr(targets, start, lam=1e3, inner=2):\n",
+    "    \"\"\"Pull template nodes with known correspondence (predicted surfaces) to their targets through one stiff TPS; the smooth skin is put back by the caller.\"\"\"\n",
+    "    X = start.copy()\n",
+    "    for _ in range(inner):\n",
+    "        S = np.vstack([X[ids] for ids, T in targets.values()]); D = np.vstack([T - X[ids] for ids, T in targets.values()])\n",
+    "        X = X + RBFInterpolator(S, D, kernel='thin_plate_spline', smoothing=np.full(len(S), lam))(X)\n",
+    "    return X\n",
+    "\n",
+    "\n",
+    "def predicted_mesh(case, preds, method='chain'):\n",
+    "    \"\"\"Register the template with the predicted skull, brain, brainstem and eyes of `case` (skin = the observed smooth skin).\"\"\"\n",
+    "    start = np.load(BATCH / case / 'l_skin.npy').astype(float)\n",
+    "    X = register_corr({k: (SUB[k], preds[case][f'{method}__{k}']) for k in S1 + S2}, start)\n",
+    "    X[skin_idx] = np.load(BATCH / case / 'skin_sm.npy').astype(float)\n",
+    "    return X"
