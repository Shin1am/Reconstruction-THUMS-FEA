+    "import pyvista as pv\n",
+    "import numpy as np\n",
+    "import matplotlib.pyplot as plt\n",
+    "import matplotlib.gridspec as gridspec\n",
+    "from matplotlib.colors import Normalize\n",
+    "from matplotlib.cm import ScalarMappable\n",
+    "from scipy.spatial import KDTree\n",
+    "import os\n",
+    "\n",
+    "# ── CONFIG — change these two paths ──────────────────────────────\n",
+    "ORIGINAL_VTU = r\"D:\\2d_3d_regis dataset\\New_version\\Data\\outputs\\vtk_export\\Head_V6.vtu\"\n",
+    "WARPED_VTU   = r\"D:\\2d_3d_regis dataset\\New_version\\Data\\outputs\\case01\\Head_V6_synra_registered.vtu\"\n",
+    "OUTPUT_PNG   = r\"D:\\2d_3d_regis dataset\\New_version\\Data\\outputs\\case01\\comparison_metrics.png\"\n",
+    "# ─────────────────────────────────────────────────────────────────\n",
+    "\n",
+    "\n",
+    "def load_vtu(path):\n",
+    "    mesh = pv.read(path)\n",
+    "    pts  = np.array(mesh.points)\n",
+    "    return mesh, pts\n",
+    "\n",
+    "\n",
+    "def compute_metrics(pts_orig, pts_warped):\n",
+    "    \"\"\"\n",
+    "    Computes a full set of shape-change metrics between\n",
+    "    the original and warped skull point clouds.\n",
+    "    \"\"\"\n",
+    "    # ── 1. Per-vertex displacement (only if same topology) ───────\n",
+    "    same_topology = pts_orig.shape == pts_warped.shape\n",
+    "    if same_topology:\n",
+    "        disp        = pts_warped - pts_orig\n",
+    "        disp_mag    = np.linalg.norm(disp, axis=1)\n",
+    "    else:\n",
+    "        disp        = None\n",
+    "        disp_mag    = None\n",
+    "\n",
+    "    # ── 2. Nearest-neighbour surface distance (works always) ─────\n",
+    "    tree_w  = KDTree(pts_warped)\n",
+    "    tree_o  = KDTree(pts_orig)\n",
+    "\n",
+    "    d_o2w, _ = tree_w.query(pts_orig)    # orig → warped\n",
+    "    d_w2o, _ = tree_o.query(pts_warped)  # warped → orig\n",
+    "\n",
+    "    symmetric_dist = np.concatenate([d_o2w, d_w2o])\n",
+    "\n",
+    "    # ── 3. Bounding box & centroid ───────────────────────────────\n",
+    "    def bbox(pts):\n",
+    "        return pts.max(axis=0) - pts.min(axis=0)\n",
+    "\n",
+    "    extent_orig   = bbox(pts_orig)\n",
+    "    extent_warped = bbox(pts_warped)\n",
+    "\n",
+    "    centroid_orig   = pts_orig.mean(axis=0)\n",
+    "    centroid_warped = pts_warped.mean(axis=0)\n",
+    "    centroid_shift  = np.linalg.norm(centroid_warped - centroid_orig)\n",
+    "\n",
+    "    metrics = {\n",
+    "        \"n_points_orig\":        len(pts_orig),\n",
+    "        \"n_points_warped\":      len(pts_warped),\n",
+    "        \"same_topology\":        same_topology,\n",
+    "        \"centroid_orig\":        centroid_orig,\n",
+    "        \"centroid_warped\":      centroid_warped,\n",
+    "        \"centroid_shift_mm\":    centroid_shift,\n",
+    "        \"extent_orig_mm\":       extent_orig,\n",
+    "        \"extent_warped_mm\":     extent_warped,\n",
+    "        \"extent_change_mm\":     extent_warped - extent_orig,\n",
+    "        \"mean_surf_dist_mm\":    symmetric_dist.mean(),\n",
+    "        \"max_surf_dist_mm\":     symmetric_dist.max(),\n",
+    "        \"std_surf_dist_mm\":     symmetric_dist.std(),\n",
+    "        \"hausdorff_mm\":         max(d_o2w.max(), d_w2o.max()),\n",
+    "        \"d_o2w\":                d_o2w,\n",
+    "        \"d_w2o\":                d_w2o,\n",
+    "        \"symmetric_dist\":       symmetric_dist,\n",
+    "        \"disp_mag\":             disp_mag,\n",
+    "    }\n",
+    "    return metrics\n",
+    "\n",
+    "\n",
+    "def plot_comparison(pts_orig, pts_warped, metrics, output_path):\n",
+    "    \"\"\"\n",
+    "    Produces a single comprehensive figure with 8 panels.\n",
+    "    \"\"\"\n",
