+    "\n",
+    "TY_cpd, _ = DeformableRegistration(X=fixed_lm, Y=TY_affine, alpha=CPD_ALPHA, beta=CPD_BETA, w=CPD_W,\n",
+    "                                   max_iterations=CPD_MAX_ITER, tolerance=CPD_TOL).register()\n",
