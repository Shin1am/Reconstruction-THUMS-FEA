+# ---------------------------------------------------------------- Stage 5 TPS (verbatim Cell 24)
+t0 = time.time()
+tps = RBFInterpolator(moving_lm, TY_cpd, kernel='thin_plate_spline', smoothing=TPS_SMOOTHING)
