+    "        ax.set_title(title, color=\"white\", fontsize=9, pad=4)\n",
+    "        for spine in ax.spines.values():\n",
+    "            spine.set_edgecolor(\"#444444\")\n",
+    "\n",
+    "    # ── Panel 1: Axial overlay (XY plane) ────────────────────────\n",
+    "    ax1 = fig.add_subplot(gs[0, 0])\n",
+    "    ax1.scatter(pts_orig[:, 0],   pts_orig[:, 1],\n",
+    "                s=0.3, c=ORIG_COL,  alpha=0.4, label=\"Original\",  rasterized=True)\n",
+    "    ax1.scatter(pts_warped[:, 0], pts_warped[:, 1],\n",
+    "                s=0.3, c=WARP_COL, alpha=0.4, label=\"Warped\", rasterized=True)\n",
+    "    style_ax(ax1, \"Axial overlay  (X–Y)\")\n",
+    "    ax1.set_xlabel(\"X (mm)\", color=\"gray\", fontsize=8)\n",
+    "    ax1.set_ylabel(\"Y (mm)\", color=\"gray\", fontsize=8)\n",
+    "    ax1.legend(fontsize=7, loc=\"upper right\",\n",
+    "               facecolor=\"#2a2a2a\", labelcolor=\"white\", markerscale=6)\n",
+    "\n",
+    "    # ── Panel 2: Coronal overlay (XZ plane) ──────────────────────\n",
