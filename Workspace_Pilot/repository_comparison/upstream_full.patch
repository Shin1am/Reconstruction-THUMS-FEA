+# ---------------------------------------------------------------- Stages 2-4 (verbatim Cells 18-22)
+t0 = time.time()
+rigid_reg = RigidRegistration(X=fixed_lm, Y=moving_lm_pca, max_iterations=CPD_MAX_ITER, tolerance=CPD_TOL)
+TY_rigid, (s_r, R_r, t_r) = rigid_reg.register()
