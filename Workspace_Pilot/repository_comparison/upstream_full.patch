+   "source": [
+    "UT_TAU, UT_MU, UT_RING = 0.10, 1e-4, 1       # target corner quality, spring to the registered position (per mm^2), rings of neighbours that may move\n",
+    "UT_PIN = ('skin',)                           # structures whose nodes get UT_SKIN_X times the spring (the observed skin should hardly move)\n",
+    "UT_SKIN_X = 20.0\n",
+    "UT_BOX = (5.0, 1.5)                          # largest move (mm) of an interior node and of a skin node from the registered position\n",
+    "\n",
+    "\n",
+    "def corner_energy(Xk, ce, tau):\n",
+    "    \"\"\"Energy sum (tau - SJ)^2 over the corners of elements `ce` with SJ < tau, and its gradient with respect to the node array Xk (k-file order).\"\"\"\n",
+    "    P = Xk[conn[ce]]\n",
+    "    E, G = 0.0, np.zeros_like(Xk)\n",
+    "    for c, (a, b, d) in CORNERS:\n",
+    "        e1, e2, e3 = P[:, a] - P[:, c], P[:, b] - P[:, c], P[:, d] - P[:, c]\n",
+    "        n1, n2, n3 = np.linalg.norm(e1, axis=1), np.linalg.norm(e2, axis=1), np.linalg.norm(e3, axis=1)\n",
+    "        den = np.maximum(n1 * n2 * n3, 1e-300)\n",
+    "        c23, c31, c12 = np.cross(e2, e3), np.cross(e3, e1), np.cross(e1, e2)\n",
+    "        s = np.einsum('ij,ij->i', e1, c23) / den\n",
+    "        act = valid[ce, c] & (s < tau)\n",
+    "        if not act.any(): continue\n",
+    "        w = np.where(act, -2.0 * (tau - s), 0.0)\n",
+    "        E += float(np.sum(np.where(act, (tau - s) ** 2, 0.0)))\n",
+    "        g1 = w[:, None] * (c23 / den[:, None] - s[:, None] * e1 / np.maximum(n1 ** 2, 1e-300)[:, None])\n",
+    "        g2 = w[:, None] * (c31 / den[:, None] - s[:, None] * e2 / np.maximum(n2 ** 2, 1e-300)[:, None])\n",
+    "        g3 = w[:, None] * (c12 / den[:, None] - s[:, None] * e3 / np.maximum(n3 ** 2, 1e-300)[:, None])\n",
+    "        nodes = conn[ce]\n",
+    "        np.add.at(G, nodes[:, a], g1); np.add.at(G, nodes[:, b], g2); np.add.at(G, nodes[:, d], g3)\n",
+    "        np.add.at(G, nodes[:, c], -(g1 + g2 + g3))\n",
+    "    return E, G\n",
+    "\n",
+    "\n",
+    "def untangle(X, tau=UT_TAU, mu=UT_MU, rings=UT_RING, maxiter=800, pin_skin=False, box=UT_BOX, log=True):\n",
+    "    \"\"\"Local mesh repair after the warp: move only the nodes of bad hexahedra (corner scaled Jacobian < tau) and their neighbours so that every corner reaches tau,\n",
+    "    while a spring holds each node near its registered position (stiffer on the skin). Returns the repaired node array (vtu order).\"\"\"\n",
+    "    from scipy.optimize import minimize\n",
+    "    Xk0 = X[k_idx].astype(float)\n",
+    "    sj = corner_sj(Xk0); bad = np.nanmin(sj, axis=1) < tau\n",
+    "    free = np.zeros(len(Xk0), bool); free[np.unique(conn[bad])] = True\n",
+    "    for _ in range(rings):\n",
+    "        free[np.unique(conn[free[conn].any(1)])] = True\n",
+    "    if pin_skin: free &= ~np.isin(k_idx, skin_idx)                  # the observed skin is never moved\n",
+    "    fi = np.where(free)[0]; ce = np.where(free[conn].any(1))[0]\n",
+    "    skin_k = np.isin(k_idx[fi], skin_idx); mu_i = np.where(skin_k, mu * UT_SKIN_X, mu)[:, None]\n",
+    "    def fun(v):\n",
+    "        Xk = Xk0.copy(); Xk[fi] = v.reshape(-1, 3)\n",
+    "        E, G = corner_energy(Xk, ce, tau)\n",
+    "        d = Xk[fi] - Xk0[fi]\n",
+    "        return E + float((mu_i * d ** 2).sum()), (G[fi] + 2.0 * mu_i * d).ravel()\n",
+    "    n0 = int((np.nanmin(sj, axis=1) <= 0).sum())\n",
+    "    lim = np.where(skin_k, box[1], box[0])[:, None] * np.ones((1, 3)); x0 = Xk0[fi]\n",
+    "    res = minimize(fun, x0.ravel(), jac=True, method='L-BFGS-B', bounds=list(zip((x0 - lim).ravel(), (x0 + lim).ravel())), options=dict(maxiter=maxiter, maxfun=maxiter * 2))\n",
+    "    Xk = Xk0.copy(); Xk[fi] = res.x.reshape(-1, 3)\n",
+    "    n1 = int((np.nanmin(corner_sj(Xk), axis=1) <= 0).sum())\n",
+    "    if log: print(f'untangle: {len(fi):,} free nodes, {len(ce):,} elements, failing {n0} -> {n1}, {res.nit} iterations, max move {np.linalg.norm(Xk[fi] - Xk0[fi], axis=1).max():.2f} mm')\n",
+    "    out = X.copy(); out[k_idx] = Xk\n",
+    "    return out"
+   ]
