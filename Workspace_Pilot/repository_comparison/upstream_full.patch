+    "print(f\"✅ Validation image saved: {val_path}\")\n",
+    "\n",
+    "# ── Dice Score (valid only for binary masks) ──────────────────────────────────\n",
+    "print(\"\\n📊 Computing Dice Score...\")\n",
+    "print(\"   (Meaningful only if both inputs are binary 0/1 masks)\")\n",
+    "try:\n",
