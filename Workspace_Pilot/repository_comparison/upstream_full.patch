+tent = cav & tent_band & ~notch[None] & (ygrid > P["Ay"] - 6 / H) & ~(s2 == 21) & ~(s2 == 20) | (cav & tent_band & ~notch[None] & (ygrid > P["Ay"] - 6 / H))
