+    nm_surf_cs = nm_surf_cs @ R_seed.T
+    nm_all_cs = nm_all_cs @ R_seed.T
+landmark_seed_applied = True   # legacy: Kabsch seed; case: axis map (applied before centering)
+tick('stage0.5b_seed', t0)
