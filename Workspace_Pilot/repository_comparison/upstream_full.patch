+    "        \n",
+    "        centre = pts.mean(axis=0)\n",
+    "        extent = np.array([\n",
+    "            bounds[1] - bounds[0],\n",
+    "            bounds[3] - bounds[2],\n",
+    "            bounds[5] - bounds[4]\n",
+    "        ])\n",
+    "        \n",
+    "        return {\n",
+    "            \"bounds\": bounds,\n",
+    "            \"centre\": centre,\n",
