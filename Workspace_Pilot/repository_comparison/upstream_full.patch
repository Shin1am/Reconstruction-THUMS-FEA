+    "reg_rigid.SetMetricAsMeanSquares()\n",
+    "reg_rigid.SetMetricSamplingStrategy(reg_rigid.RANDOM)\n",
+    "reg_rigid.SetMetricSamplingPercentage(0.20)\n",
+    "reg_rigid.SetInterpolator(sitk.sitkLinear)\n",
