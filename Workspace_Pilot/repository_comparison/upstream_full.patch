+    return sitk.GetArrayFromImage(sitk.Resample(im_, [int(p.shape[1]*s), h], sitk.Transform(), sitk.sitkNearestNeighbor, im_.GetOrigin(), (1/s, 1/s), im_.GetDirection(), 0)).astype(np.uint8)
